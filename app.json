{
  "expo": {
    "name": "SOMA",
    "slug": "soma",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon-soma.png",

    "scheme": "soma",
    "userInterfaceStyle": "automatic",

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3D1E45",
          "image": "./assets/images/logo-soma.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SOMA usa sua localização só para mostrar os dados da região e os serviços de apoio mais próximos. A localização não é salva nem enviada."
        }
      ]
    ],

    "ios": {
      "icon": "./assets/images/icon-soma.png"
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.projetosoma.app",

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-soma.png",
        "backgroundColor": "#3D1E45"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-soma.png"
    },

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "72542690-8479-4fb7-a8be-838935b975e7"
      }
    }
  }
}